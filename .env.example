# Firebase service account env vars (do NOT commit real secrets)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Keep literal \n newlines in the key value
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...your key here...\n-----END PRIVATE KEY-----\n

# Stripe billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID_PREMIUM=price_xxx_premium
STRIPE_PRICE_ID_CORE=price_xxx_core

# RevenueCat (optional Apple IAP bridge)
REVENUECAT_WEBHOOK_SECRET=rc_webhook_secret_optional

# Food AI: Claude is primary; Qwen is an outage-only degraded fallback.
CLAUDE_API_KEY=sk-ant-api03-your-key
FOOD_AI_PROVIDER=claude
FOOD_AI_CLAUDE_TEXT_MODEL=claude-sonnet-5
FOOD_AI_CLAUDE_VISION_MODEL=claude-sonnet-5
FOOD_AI_CLAUDE_REVIEW_MODEL=claude-opus-5
FOOD_AI_FALLBACK_PROVIDER=qwen
FOOD_AI_BASE_URL=https://router.huggingface.co/v1
FOOD_AI_TEXT_MODEL=Qwen/Qwen3-8B
FOOD_AI_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
FOOD_AI_API_KEY=hf_your-fallback-key
