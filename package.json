{
  "name": "fuelfire-app",
  "version": "2.1.0",
  "description": "FuelFire - AI-Powered Fitness & Nutrition App with Claude AI meal planning",
  "main": "public/index.html",
  "scripts": {
    "test": "npm run test:free",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile-chromium",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:ios:ui": "zsh scripts/run-ios-ui-tests.sh",
    "test:free": "npm run test:unit && npm run test:ai-food:regression && npm run test:accuracy && npm run test:e2e",
    "test:ci": "npm run test:coverage && npm run test:ai-food:regression && npm run test:accuracy && npm run test:e2e",
    "test:live:limited": "npm run test:ai-food:vision:live && npm run test:ai-workout && npm run test:ai-meal-plan",
    "test:release": "npm run test:free && npm run test:live:limited",
    "dev": "npx serve public -p 3000",
    "build": "echo 'Static app with serverless API - ready for deployment'",
    "start": "npx serve public -p 3000",
    "deploy": "vercel --prod",
    "audit:workout-images": "node scripts/audit-workout-form-images.js",
    "workout:image-research": "node scripts/research-workout-form-references.js",
    "workout:image-plan": "node scripts/create-workout-form-image-plan.js",
    "workout:image-plan:chest": "node scripts/create-workout-form-image-plan.js --muscle chest",
    "workout:image-approvals": "node scripts/update-workout-form-image-approvals.js --write",
    "workout:image-jobs": "node scripts/prepare-workout-form-image-generation.js",
    "workout:image-install": "node scripts/install-workout-form-images.js",
    "workout:image-publish": "node scripts/publish-workout-form-image-manifest.js",
    "workout:image-publish:chest": "node scripts/publish-workout-form-image-manifest.js --muscle chest",
    "workout:image-publish:chest:approved": "node scripts/publish-workout-form-image-manifest.js --muscle chest --approval-file scripts/workout-form-image-approvals.json",
    "workout:image-publish:chest:partial": "node scripts/publish-workout-form-image-manifest.js --muscle chest --allow-partial",
    "verify:anthropic": "node scripts/verify-anthropic-model.js",
    "verify": "npm run verify:anthropic && npm run audit:workout-images",
    "test:ai-food": "node tests/run-ai-food-realworld.js",
    "test:ai-food:regression": "node tests/run-ai-food-regression.js",
    "test:accuracy": "node tests/accuracy/run-food-accuracy.mjs --mode=fixture --gate",
    "test:accuracy:live": "node tests/accuracy/run-food-accuracy.mjs --mode=live --max-live-calls=5 --max-estimated-cost-usd=0.25 --gate=false",
    "test:ai-food:text": "node tests/run-ai-food-realworld.js --text-only",
    "test:ai-food:vision:live": "INCLUDE_VISION=1 node tests/run-ai-food-realworld.js --include-vision --vision-limit=2",
    "test:ai-food:deep": "node tests/run-ai-food-deep-30.js",
    "test:ai-workout": "node tests/run-ai-workout-smoke.js",
    "test:ai-meal-plan": "node tests/run-ai-meal-plan-smoke.js",
    "cap:sync": "npx cap sync",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build": "cd android && ./gradlew assembleRelease",
    "prepare:android": "npm run cap:sync && npm run cap:copy"
  },
  "keywords": [
    "fitness",
    "nutrition",
    "ai",
    "meal-planning",
    "claude-ai",
    "diet",
    "workout",
    "health",
    "personalized-plans"
  ],
  "author": "Dan Perry",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "serve": "^14.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dan40000000/fuelfire-app.git"
  },
  "bugs": {
    "url": "https://github.com/Dan40000000/fuelfire-app/issues"
  },
  "homepage": "https://github.com/Dan40000000/fuelfire-app#readme",
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-mlkit/barcode-scanning": "^7.3.0",
    "@capacitor/android": "^7.4.3",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/cli": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@capgo/capacitor-health": "^7.0.10",
    "@revenuecat/purchases-capacitor": "^11.3.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "stripe": "^20.0.0"
  }
}
